 # @brief Maybe enable pedantic warnings for a target
 function(maybe_target_pedantic_warnings TARGET_NAME)
+    # Clang 21+ flags unused function templates in the freestanding headers
+    # under -Wall. The templates are part of matplot's public API surface, so
+    # consumer TUs that include matplot.h trigger them too; suppress here and
+    # propagate (PUBLIC) to every target that links against matplot.
+    target_compile_options(${TARGET_NAME} PUBLIC
+        $<$<COMPILE_LANG_AND_ID:CXX,Clang,AppleClang>:-Wno-unused-template>)
     if (MATPLOTPP_BUILD_WITH_PEDANTIC_WARNINGS)
         target_pedantic_warnings(${TARGET_NAME})
     endif ()
 endfunction ()
