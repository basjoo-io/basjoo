string(FIND "${CMAKE_C_FLAGS}" "/arch:AVX2" _OPENBLAS_ARCH_IDX)
if(_OPENBLAS_ARCH_IDX EQUAL -1)
  message(FATAL_ERROR "OpenBLAS: cannot detect a supported /arch in CMAKE_C_FLAGS (expected /arch:AVX2)")
endif()
set(_OPENBLAS_TARGET HASWELL)

if(BUILD_SHARED_LIBS)
  set(_OPENBLAS_BUILD_STATIC_LIBS OFF)
  set(_OPENBLAS_BUILD_SHARED_LIBS ON)
else()
  set(_OPENBLAS_BUILD_STATIC_LIBS ON)
  set(_OPENBLAS_BUILD_SHARED_LIBS OFF)
endif()

set(_OPENBLAS_INSTALL_BYPRODUCTS ${CMAKE_CURRENT_BINARY_DIR}/_deps/openblas-install/lib/openblas.lib)
if(BUILD_SHARED_LIBS)
  list(APPEND _OPENBLAS_INSTALL_BYPRODUCTS ${CMAKE_CURRENT_BINARY_DIR}/_deps/openblas-install/bin/openblas.dll)
endif()

ExternalProject_Add(OpenBLAS
  PREFIX ${CMAKE_CURRENT_BINARY_DIR}/_deps
  TMP_DIR ${CMAKE_CURRENT_BINARY_DIR}/_deps/openblas-tmp
  STAMP_DIR ${CMAKE_CURRENT_BINARY_DIR}/_deps/openblas-stamp
  SOURCE_DIR ${OpenBLAS_SOURCE_DIR}
  BINARY_DIR ${CMAKE_CURRENT_BINARY_DIR}/_deps/openblas-build
  INSTALL_DIR ${CMAKE_CURRENT_BINARY_DIR}/_deps/openblas-install
  CMAKE_GENERATOR Ninja
  CMAKE_ARGS
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5
    -DCMAKE_TOOLCHAIN_FILE=${CMAKE_TOOLCHAIN_FILE}
    -DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE}
    -DCMAKE_COMPILE_WARNING_AS_ERROR=OFF
    -DCMAKE_BINARY_DIR=<BINARY_DIR>
    -DCMAKE_INSTALL_PREFIX=<INSTALL_DIR>
    -DBUILD_STATIC_LIBS=${_OPENBLAS_BUILD_STATIC_LIBS}
    -DBUILD_SHARED_LIBS=${_OPENBLAS_BUILD_SHARED_LIBS}
    -DBUILD_TESTING=OFF
    -DNOFORTRAN=ON
    -DC_LAPACK=ON
    -DTARGET=${_OPENBLAS_TARGET}
    -DDYNAMIC_ARCH=OFF
    -DUSE_THREAD=OFF
    -DUSE_OPENMP=OFF
  BUILD_BYPRODUCTS
    ${CMAKE_CURRENT_BINARY_DIR}/_deps/openblas-build/openblas.lib
  INSTALL_BYPRODUCTS
    ${_OPENBLAS_INSTALL_BYPRODUCTS}
  LOG_CONFIGURE True
  LOG_BUILD True
  LOG_INSTALL True
  LOG_OUTPUT_ON_FAILURE True
)

set(_OPENBLAS_INSTALL_DIR ${CMAKE_CURRENT_BINARY_DIR}/_deps/openblas-install)
set(_OPENBLAS_INCLUDE_DIR ${_OPENBLAS_INSTALL_DIR}/include/openblas)

add_dependencies(blas_lapack OpenBLAS)

target_compile_definitions(blas_lapack INTERFACE
  HAVE_LAPACK_CONFIG_H
  LAPACK_COMPLEX_CPP
  BASJOO_USE_BLAS_LAPACK
)
target_compile_options(blas_lapack INTERFACE /wd4190)
target_include_directories(blas_lapack INTERFACE
  "$<BUILD_INTERFACE:${_OPENBLAS_INCLUDE_DIR}>"
  "$<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>"
)
target_link_libraries(blas_lapack INTERFACE
  "$<BUILD_INTERFACE:${_OPENBLAS_INSTALL_DIR}/lib/openblas.lib>"
  "$<INSTALL_INTERFACE:${CMAKE_INSTALL_LIBDIR}/openblas.lib>"
)

if(BASJOO_ENABLE_INSTALL)
  install(
    DIRECTORY ${_OPENBLAS_INSTALL_DIR}/.
    DESTINATION ${CMAKE_INSTALL_PREFIX}
  )
endif()

set(BLAS_FOUND True CACHE INTERNAL "set BLAS found")
set(BLAS_INCLUDE_DIRS "$<BUILD_INTERFACE:${_OPENBLAS_INCLUDE_DIR}>;$<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>" CACHE INTERNAL "set BLAS include directory")
set(BLAS_LIBRARIES "blas_lapack" CACHE INTERNAL "set BLAS library")
set(BLAS_LINKER_FLAGS "" CACHE INTERNAL "set BLAS linker flags")
set(LAPACK_FOUND True CACHE INTERNAL "set LAPACK found")
set(LAPACK_INCLUDE_DIRS ${BLAS_INCLUDE_DIRS} CACHE INTERNAL "set LAPACK include directory")
set(LAPACK_LIBRARIES ${BLAS_LIBRARIES} CACHE INTERNAL "set LAPACK library")
set(LAPACK_LINKER_FLAGS "${BLAS_LINKER_FLAGS}" CACHE INTERNAL "set LAPACK linker flags")

unset(_OPENBLAS_ARCH_IDX)
unset(_OPENBLAS_TARGET)
unset(_OPENBLAS_BUILD_STATIC_LIBS)
unset(_OPENBLAS_BUILD_SHARED_LIBS)
unset(_OPENBLAS_INSTALL_BYPRODUCTS)
unset(_OPENBLAS_INSTALL_DIR)
unset(_OPENBLAS_INCLUDE_DIR)
