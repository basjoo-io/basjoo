enable_language(Fortran)

string(REGEX REPLACE "^([0-9]+)\\..*" "\\1" _FORTRAN_MAJOR_VERSION "${CMAKE_Fortran_COMPILER_VERSION}")

set(_OPENBLAS_CC ${CMAKE_C_COMPILER_LAUNCHER}\ ${CMAKE_C_COMPILER})
set(_OPENBLAS_FC ${CMAKE_Fortran_COMPILER_LAUNCHER}\ ${CMAKE_Fortran_COMPILER})

string(TOUPPER "${CMAKE_BUILD_TYPE}" _OPENBLAS_BUILD_TYPE_UPPER)
if(CMAKE_INTERPROCEDURAL_OPTIMIZATION_${_OPENBLAS_BUILD_TYPE_UPPER})
  string(JOIN "\ " _OPENBLAS_COMPILE_OPTIONS_IPO ${CMAKE_C_COMPILE_OPTIONS_IPO})
  string(JOIN "\ " _OPENBLAS_LINK_OPTIONS_IPO ${CMAKE_C_LINK_OPTIONS_IPO})
else()
  set(_OPENBLAS_COMPILE_OPTIONS_IPO -fno-lto)
  set(_OPENBLAS_LINK_OPTIONS_IPO -fno-lto)
endif()

if(CMAKE_C_COMPILER_ID STREQUAL "GNU" AND CMAKE_Fortran_COMPILER_ID STREQUAL "GNU")

  set(_OPENBLAS_ASMFLAGS ${CMAKE_C_FLAGS}\ ${CMAKE_C_FLAGS_${_OPENBLAS_BUILD_TYPE_UPPER}}\ ${_OPENBLAS_COMPILE_OPTIONS_IPO})
  set(_OPENBLAS_CFLAGS ${_OPENBLAS_ASMFLAGS})
  set(_OPENBLAS_FFLAGS ${CMAKE_Fortran_FLAGS}\ ${CMAKE_Fortran_FLAGS_${_OPENBLAS_BUILD_TYPE_UPPER}}\ ${_OPENBLAS_COMPILE_OPTIONS_IPO})
  set(_OPENBLAS_LDFLAGS ${_OPENBLAS_LINK_OPTIONS_IPO})
  set(_OPENBLAS_INTERFACE_LINK_LIBRARIES "gfortran;quadmath")

elseif(CMAKE_C_COMPILER_ID STREQUAL "Clang" AND CMAKE_Fortran_COMPILER_ID STREQUAL "LLVMFlang")

  set(_OPENBLAS_ASMFLAGS ${CMAKE_C_FLAGS}\ ${CMAKE_C_FLAGS_${_OPENBLAS_BUILD_TYPE_UPPER}}\ -fno-sanitize=address,undefined\ -fno-lto)
  set(_OPENBLAS_CFLAGS ${_OPENBLAS_ASMFLAGS})
  set(_OPENBLAS_FFLAGS ${CMAKE_Fortran_FLAGS}\ ${CMAKE_Fortran_FLAGS_${_OPENBLAS_BUILD_TYPE_UPPER}}\ -fno-lto)
  set(_OPENBLAS_LDFLAGS -rtlib=compiler-rt\ -fno-lto)
  set(_OPENBLAS_INTERFACE_LINK_LIBRARIES "/opt/homebrew/opt/flang/lib/clang/${_FORTRAN_MAJOR_VERSION}/lib/darwin/libflang_rt.runtime.dylib")

elseif(CMAKE_C_COMPILER_ID STREQUAL "Clang" AND CMAKE_Fortran_COMPILER_ID STREQUAL "GNU")

  set(_OPENBLAS_ASMFLAGS ${CMAKE_C_FLAGS}\ ${CMAKE_C_FLAGS_${_OPENBLAS_BUILD_TYPE_UPPER}}\ -fno-sanitize=address,undefined\ -fno-lto)
  set(_OPENBLAS_CFLAGS ${_OPENBLAS_ASMFLAGS})
  set(_OPENBLAS_FFLAGS ${CMAKE_Fortran_FLAGS}\ ${CMAKE_Fortran_FLAGS_${_OPENBLAS_BUILD_TYPE_UPPER}}\ -fno-sanitize=address,undefined\ -fno-lto)
  set(_OPENBLAS_LDFLAGS -rtlib=compiler-rt\ -fno-lto)
  set(_OPENBLAS_INTERFACE_LINK_LIBRARIES "gfortran;quadmath")

endif()

string(FIND "${CMAKE_C_FLAGS}" "-march=armv8-a" _OPENBLAS_MARCH_IDX)
if(_OPENBLAS_MARCH_IDX EQUAL -1)
  message(FATAL_ERROR "OpenBLAS: cannot detect a supported -march in CMAKE_C_FLAGS (expected -march=armv8-a)")
endif()
set(_OPENBLAS_TARGET ARMV8)

if(BUILD_SHARED_LIBS)
  set(_OPENBLAS_LIB_KIND_ARG NO_STATIC=1)
  set(_OPENBLAS_BUILD_BYPRODUCTS ${CMAKE_CURRENT_BINARY_DIR}/_deps/openblas-build/libopenblas.dylib)
  set(_OPENBLAS_INSTALL_BYPRODUCTS ${CMAKE_CURRENT_BINARY_DIR}/_deps/openblas-install/lib/libopenblas.dylib)
else()
  set(_OPENBLAS_LIB_KIND_ARG NO_SHARED=1)
  set(_OPENBLAS_BUILD_BYPRODUCTS ${CMAKE_CURRENT_BINARY_DIR}/_deps/openblas-build/libopenblas.a)
  set(_OPENBLAS_INSTALL_BYPRODUCTS ${CMAKE_CURRENT_BINARY_DIR}/_deps/openblas-install/lib/libopenblas.a)
endif()

ExternalProject_Add(OpenBLAS
  PREFIX ${CMAKE_CURRENT_BINARY_DIR}/_deps
  TMP_DIR ${CMAKE_CURRENT_BINARY_DIR}/_deps/openblas-tmp
  STAMP_DIR ${CMAKE_CURRENT_BINARY_DIR}/_deps/openblas-stamp
  SOURCE_DIR ${OpenBLAS_SOURCE_DIR}
  BINARY_DIR ${CMAKE_CURRENT_BINARY_DIR}/_deps/openblas-build
  INSTALL_DIR ${CMAKE_CURRENT_BINARY_DIR}/_deps/openblas-install
  CONFIGURE_COMMAND ${CMAKE_COMMAND} -E copy_directory_if_different <SOURCE_DIR>/. <BINARY_DIR>
  BUILD_COMMAND ${CMAKE_COMMAND} -E env AR=${CMAKE_AR} RANLIB=${CMAKE_RANLIB} CC=${_OPENBLAS_CC} FC=${_OPENBLAS_FC} ASMFLAGS=${_OPENBLAS_ASMFLAGS} CFLAGS=${_OPENBLAS_CFLAGS} FFLAGS=${_OPENBLAS_FFLAGS} LDFLAGS=${_OPENBLAS_LDFLAGS} TARGET=${_OPENBLAS_TARGET} DYNAMIC_ARCH=0 NO_AFFINITY=0 USE_THREAD=0 USE_LOCKING=0 USE_OPENMP=0 ${_OPENBLAS_LIB_KIND_ARG} make shared
  INSTALL_COMMAND make -C <BINARY_DIR> PREFIX=<INSTALL_DIR> ${_OPENBLAS_LIB_KIND_ARG} install
  BUILD_BYPRODUCTS
    ${_OPENBLAS_BUILD_BYPRODUCTS}
  INSTALL_BYPRODUCTS
    ${_OPENBLAS_INSTALL_BYPRODUCTS}
  LOG_CONFIGURE True
  LOG_BUILD True
  LOG_INSTALL True
  LOG_OUTPUT_ON_FAILURE True
)

set(_OPENBLAS_INSTALL_DIR ${CMAKE_CURRENT_BINARY_DIR}/_deps/openblas-install)
set(_OPENBLAS_INCLUDE_DIR ${_OPENBLAS_INSTALL_DIR}/include)

add_dependencies(blas_lapack OpenBLAS)

target_compile_definitions(blas_lapack INTERFACE BASJOO_USE_BLAS_LAPACK)
target_compile_options(blas_lapack INTERFACE -Wno-c99-extensions)
target_include_directories(blas_lapack INTERFACE
  "$<BUILD_INTERFACE:${_OPENBLAS_INCLUDE_DIR}>"
  "$<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>"
)
if(BUILD_SHARED_LIBS)
  target_link_libraries(blas_lapack INTERFACE
    "$<BUILD_INTERFACE:${_OPENBLAS_INSTALL_DIR}/lib/libopenblas.dylib>"
    "$<INSTALL_INTERFACE:${CMAKE_INSTALL_LIBDIR}/libopenblas.dylib>"
    ${_OPENBLAS_INTERFACE_LINK_LIBRARIES}
  )
else()
  target_link_libraries(blas_lapack INTERFACE
    "$<BUILD_INTERFACE:${_OPENBLAS_INSTALL_DIR}/lib/libopenblas.a>"
    "$<INSTALL_INTERFACE:${CMAKE_INSTALL_LIBDIR}/libopenblas.a>"
    ${_OPENBLAS_INTERFACE_LINK_LIBRARIES}
  )
endif()

if(BASJOO_ENABLE_INSTALL)
  install(
    DIRECTORY ${_OPENBLAS_INSTALL_DIR}/.
    DESTINATION ${CMAKE_INSTALL_PREFIX}
  )
endif()

set(BLAS_FOUND True CACHE INTERNAL "set BLAS found")
set(BLAS_INCLUDE_DIRS "$<BUILD_INTERFACE:${_OPENBLAS_INCLUDE_DIR}>;$<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>" CACHE INTERNAL "set BLAS include directory")
set(BLAS_LIBRARIES "blas_lapack" CACHE INTERNAL "set BLAS library")
set(BLAS_LINKER_FLAGS "" CACHE INTERNAL "set BLAS linker flags")
set(LAPACK_FOUND True CACHE INTERNAL "set LAPACK found")
set(LAPACK_INCLUDE_DIRS ${BLAS_INCLUDE_DIRS} CACHE INTERNAL "set LAPACK include directory")
set(LAPACK_LIBRARIES ${BLAS_LIBRARIES} CACHE INTERNAL "set LAPACK library")
set(LAPACK_LINKER_FLAGS "${BLAS_LINKER_FLAGS}" CACHE INTERNAL "set LAPACK linker flags")

unset(_FORTRAN_MAJOR_VERSION)
unset(_OPENBLAS_BUILD_TYPE_UPPER)
unset(_OPENBLAS_CC)
unset(_OPENBLAS_FC)
unset(_OPENBLAS_COMPILE_OPTIONS_IPO)
unset(_OPENBLAS_LINK_OPTIONS_IPO)
unset(_OPENBLAS_ASMFLAGS)
unset(_OPENBLAS_CFLAGS)
unset(_OPENBLAS_FFLAGS)
unset(_OPENBLAS_LDFLAGS)
unset(_OPENBLAS_INTERFACE_LINK_LIBRARIES)
unset(_OPENBLAS_MARCH_IDX)
unset(_OPENBLAS_TARGET)
unset(_OPENBLAS_LIB_KIND_ARG)
unset(_OPENBLAS_BUILD_BYPRODUCTS)
unset(_OPENBLAS_INSTALL_BYPRODUCTS)
unset(_OPENBLAS_INSTALL_DIR)
unset(_OPENBLAS_INCLUDE_DIR)
